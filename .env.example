# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
USE_LOCAL_LLM=true
OLLAMA_MODEL=qwen2.5:7b

DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5433/omnimind_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=omnimind_db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

MINIO_URL=localhost:9000
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_SECURE=false

GROQ_API_KEY=
GROQ_VISION_API_KEY=
GROQ_GENERATION_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_ASR_API_KEY=

# Video RAG (ffmpeg required on PATH for ASR audio extract)
VIDEO_ASR_ENABLED=true
VIDEO_VISION_ENABLED=true
VIDEO_FRAME_INTERVAL_SEC=15
VIDEO_MAX_KEYFRAMES=12
VIDEO_SCENE_DIFF_THRESHOLD=8

LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=Aegis
