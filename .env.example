JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=7

# development | production — production refuses default JWT/DB/MinIO secrets at API boot
APP_ENV=development
# true  = local Ollama Qwen first (cost-effective for daily dev/test)
# false = skip Ollama; Groq → OpenRouter free (demos / low RAM / ngrok share)
USE_LOCAL_LLM=true
OLLAMA_MODEL=qwen2.5:7b

DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5433/omnimind_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=omnimind_db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2

MINIO_URL=localhost:9000
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_SECURE=false

GROQ_API_KEY=
GROQ_VISION_API_KEY=
GROQ_GENERATION_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_GENERATION_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_ASR_API_KEY=

# OpenRouter FALLBACK only — use :free models from OpenRouter free catalog
OPENROUTER_API_KEY=
OPENROUTER_VISION_API_KEY=
OPENROUTER_GENERATION_MODEL=openai/gpt-oss-20b:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# Leave empty unless you add a free STT model (none in current free list)
OPENROUTER_WHISPER_MODEL=

# RAGAS evaluation (local Qwen judge by default — avoids Groq rate limits)
RAGAS_LLM_PROVIDER=ollama
RAGAS_OLLAMA_MODEL=qwen2.5:7b
RAGAS_EVALUATION_THRESHOLD=0.5

# Video RAG (ffmpeg required on PATH for ASR audio extract)
VIDEO_ASR_ENABLED=true
# Set false to skip Groq vision captions under free-tier rate limits (ASR-only video RAG)
VIDEO_VISION_ENABLED=true
VIDEO_FRAME_INTERVAL_SEC=8
VIDEO_MAX_KEYFRAMES=20
VIDEO_SCENE_DIFF_THRESHOLD=8

LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=Aegis

# Frontend origins (comma-separated). Ngrok https://*.ngrok-free.dev also allowed via CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# CORS_ORIGIN_REGEX=https://.*\.ngrok-free\.dev|https://.*\.ngrok-free\.app|https://.*\.ngrok\.io
